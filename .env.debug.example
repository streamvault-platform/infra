# Debug environment — copy to .env to run the stack with local builds + JDWP.
#
# Build JARs before running docker compose build:
#   ../core/mvnw -f ../core/pom.xml package -DskipTests
#   (cd ../pipeline && sbt assembly)
#
# Then:
#   docker compose --profile standard \
#     -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.debug.yml \
#     build && \
#   docker compose --profile standard \
#     -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.debug.yml \
#     up -d

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=streamvault
POSTGRES_PASSWORD=changeme
POSTGRES_DB=streamvault_core

# ── Kafka (KRaft) ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import uuid; print(uuid.uuid4())"
KAFKA_CLUSTER_ID=
KAFKA_NODE_ID=1

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# ── RustFS (S3-compatible object storage) ──────────────────────────────────
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=changeme
RUSTFS_PORT=9000
STREAMVAULT_S3_BUCKET=streamvault-media
STREAMVAULT_S3_REGION=us-east-1

# ── Storage backend ────────────────────────────────────────────────────────
STREAMVAULT_STORAGE_BACKEND=s3
STREAMVAULT_MEDIA_PATH=/var/streamvault/media
STREAMVAULT_INTERNAL_BASE_URL=http://streamvault-core:8080
STREAMVAULT_INTERNAL_SIGNING_SECRET=

# ── Envoy ──────────────────────────────────────────────────────────────────
ENVOY_HTTP_PORT=8080
ENVOY_HTTPS_PORT=8443

# ── Application images (local builds) ─────────────────────────────────────
CORE_IMAGE=streamvault-core:local
PIPELINE_IMAGE=streamvault-pipeline:local

# ── Pipeline ───────────────────────────────────────────────────────────────
PIPELINE_CONSUMER_GROUP=streamvault-pipeline
PIPELINE_METRICS_INTERVAL=15 seconds

# ── Debug ──────────────────────────────────────────────────────────────────
DEBUG_PORT=5005
PIPELINE_DEBUG_PORT=5006

# ── Observability (full profile only) ──────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
KAFKA_UI_PORT=8090
