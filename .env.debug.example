# Debug environment — copy to .env to run the stack with local builds + JDWP.
#
# Build JARs before running docker compose build:
#   ../core/mvnw -f ../core/pom.xml package -DskipTests
#   (cd ../pipeline && sbt assembly)
#
# Then:
#   docker compose --profile standard \
#     -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.debug.yml \
#     build && \
#   docker compose --profile standard \
#     -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.debug.yml \
#     up -d

# ── Shared secrets (required for all backends) ─────────────────────────────

POSTGRES_USER=streamvault
POSTGRES_PASSWORD=changeme
DB_MIGRATOR_PASSWORD=changeme
DB_APP_PASSWORD=changeme

REDIS_PASSWORD=changeme

# generate with: openssl rand 16 | base64 | tr '+/' '-_' | tr -d '=\n'
KAFKA_CLUSTER_ID=
KAFKA_NODE_ID=1

# One shared secret used for: RustFS password, S3 secret key, and filesystem
# HMAC signing. Generate once per deployment: openssl rand -hex 32
STREAMVAULT_SECRET_KEY=changeme

# ── Storage backend ────────────────────────────────────────────────────────
STREAMVAULT_STORAGE_BACKEND=s3

# ── S3 backend settings ────────────────────────────────────────────────────
STREAMVAULT_S3_ENDPOINT=http://streamvault-rustfs:9000
STREAMVAULT_S3_ACCESS_KEY=rustfsadmin
STREAMVAULT_S3_BUCKET=streamvault-media
STREAMVAULT_S3_REGION=us-east-1
RUSTFS_PORT=9000

# ── Filesystem backend settings (only used when STREAMVAULT_STORAGE_BACKEND=filesystem) ──
STREAMVAULT_MEDIA_PATH=/var/streamvault/media
STREAMVAULT_INTERNAL_BASE_URL=http://streamvault-core:8080

# ── Envoy (edge gateway) ───────────────────────────────────────────────────
ENVOY_HTTP_PORT=18080
ENVOY_HTTPS_PORT=18443

# ── Application images (local builds) ─────────────────────────────────────
CORE_IMAGE=streamvault-core:local
PIPELINE_IMAGE=streamvault-pipeline:local
WEB_IMAGE=streamvault-web:local

# ── Web client ─────────────────────────────────────────────────────────────
STREAMVAULT_API_URL=

# ── Pipeline ───────────────────────────────────────────────────────────────
PIPELINE_CONSUMER_GROUP=streamvault-pipeline
PIPELINE_METRICS_INTERVAL=15 seconds

# ── Debug ──────────────────────────────────────────────────────────────────
DEBUG_PORT=5005
PIPELINE_DEBUG_PORT=5006

# ── Observability (full profile only: docker compose --profile full up -d) ───
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
KAFKA_UI_PORT=8090
