# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=streamvault
POSTGRES_PASSWORD=changeme
POSTGRES_DB=streamvault_core

# ── Kafka (KRaft) ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import uuid; print(uuid.uuid4())"
KAFKA_CLUSTER_ID=
KAFKA_NODE_ID=1

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# ── RustFS (S3-compatible object storage) ──────────────────────────────────
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=changeme
RUSTFS_PORT=9000
STREAMVAULT_S3_BUCKET=streamvault-media
STREAMVAULT_S3_REGION=us-east-1

# ── Storage backend ────────────────────────────────────────────────────────
# "s3" (default) — uses RustFS via the S3 API above
# "filesystem"   — stores files locally; requires the vars below
STREAMVAULT_STORAGE_BACKEND=s3

# Required when STREAMVAULT_STORAGE_BACKEND=filesystem:
STREAMVAULT_MEDIA_PATH=/var/streamvault/media
# Core's own base URL — used to generate pre-signed URLs pointing at itself for the pipeline
STREAMVAULT_INTERNAL_BASE_URL=http://streamvault-core:8080
# HMAC key for signing internal pre-signed URLs; generate with: openssl rand -hex 32
STREAMVAULT_INTERNAL_SIGNING_SECRET=

# ── Envoy ──────────────────────────────────────────────────────────────────
ENVOY_HTTP_PORT=8080
ENVOY_HTTPS_PORT=8443

# ── Application images ─────────────────────────────────────────────────────
# Override to use a locally built image instead of the registry default
CORE_IMAGE=ghcr.io/streamvault-platform/core:0.1.0-dev
PIPELINE_IMAGE=ghcr.io/streamvault-platform/pipeline:0.1.0-dev

# ── Pipeline ───────────────────────────────────────────────────────────────
PIPELINE_CONSUMER_GROUP=streamvault-pipeline
PIPELINE_METRICS_INTERVAL=15 seconds

# ── Observability (full profile only) ──────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
KAFKA_UI_PORT=8090
