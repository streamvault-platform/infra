# Copy this file to .env and fill in your values before running docker compose.

# ── Shared secrets (required for all backends) ─────────────────────────────

POSTGRES_USER=streamvault
# generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# generate with: openssl rand -hex 24
DB_MIGRATOR_PASSWORD=
# generate with: openssl rand -hex 24
DB_APP_PASSWORD=

# generate with: openssl rand -hex 24
REDIS_PASSWORD=

# Base64url-encoded UUID — generate with:
#   openssl rand 16 | base64 | tr '+/' '-_' | tr -d '=\n'
KAFKA_CLUSTER_ID=
KAFKA_NODE_ID=1

# One shared secret used for: RustFS password, S3 secret key, and filesystem
# HMAC signing. Generate once per deployment: openssl rand -hex 32
# External S3 users: set STREAMVAULT_S3_SECRET_KEY below to override for S3.
STREAMVAULT_SECRET_KEY=

# ── Storage backend ────────────────────────────────────────────────────────
# "s3" (default) — uses embedded RustFS or external S3 (see sections below)
# "filesystem"   — stores files on the host at STREAMVAULT_MEDIA_PATH
STREAMVAULT_STORAGE_BACKEND=s3

# ── S3 backend settings ────────────────────────────────────────────────────
# Defaults below use the embedded RustFS container.
# For external S3 (AWS, Backblaze B2, etc.):
#   - Set STREAMVAULT_S3_ENDPOINT to the provider endpoint URL.
#     Leave empty for real AWS S3 (uses default credentials chain / IRSA).
#   - Set STREAMVAULT_S3_ACCESS_KEY to your access key (or leave blank for IRSA).
#     Defaults to RUSTFS_ACCESS_KEY if not set (correct for embedded RustFS).
#   - Set STREAMVAULT_S3_SECRET_KEY to your S3 secret key.
#     Defaults to STREAMVAULT_SECRET_KEY if not set (correct for embedded RustFS).
STREAMVAULT_S3_ENDPOINT=http://streamvault-rustfs:9000
# Admin key for the embedded RustFS container. External S3 users: leave this
# alone and set STREAMVAULT_S3_ACCESS_KEY below instead.
RUSTFS_ACCESS_KEY=rustfsadmin
# Override only for external S3 — defaults to RUSTFS_ACCESS_KEY
#STREAMVAULT_S3_ACCESS_KEY=
# Override only for external S3 — defaults to STREAMVAULT_SECRET_KEY
#STREAMVAULT_S3_SECRET_KEY=
STREAMVAULT_S3_BUCKET=streamvault-media
STREAMVAULT_S3_REGION=us-east-1
RUSTFS_PORT=9000

# ── Auth & registration ────────────────────────────────────────────────────
# Set to "true" to allow anyone to register without an invite link.
# When false (default), users need a single-use invite link generated by an admin.
STREAMVAULT_OPEN_REGISTRATION=false

# Default expiry for invite links in days. 0 = links never expire.
STREAMVAULT_INVITE_DEFAULT_EXPIRY_DAYS=7

# ── Filesystem backend settings (only used when STREAMVAULT_STORAGE_BACKEND=filesystem) ──
# STREAMVAULT_INTERNAL_SIGNING_SECRET defaults to STREAMVAULT_SECRET_KEY — no change needed.
STREAMVAULT_MEDIA_PATH=/var/streamvault/media
STREAMVAULT_INTERNAL_BASE_URL=http://streamvault-core:8080

# ── Envoy (edge gateway) ───────────────────────────────────────────────────
ENVOY_HTTP_PORT=18080
ENVOY_HTTPS_PORT=18443

# ── Application images ─────────────────────────────────────────────────────
CORE_IMAGE=ghcr.io/streamvault-platform/core:0.1.0-dev
PIPELINE_IMAGE=ghcr.io/streamvault-platform/pipeline:0.1.0-dev
WEB_IMAGE=ghcr.io/streamvault-platform/web:0.1.0-dev

# ── Web client ─────────────────────────────────────────────────────────────
# Only needed for split deployments where the web client and backend run on
# different servers. Set to the external URL of your Envoy gateway so the
# browser knows where to reach the API. Leave empty (default) when deploying
# the full stack together — Envoy routes everything and window.location.origin
# resolves correctly without it.
# Example: STREAMVAULT_API_URL=https://api.myserver.com
STREAMVAULT_API_URL=

# ── Pipeline ───────────────────────────────────────────────────────────────
PIPELINE_CONSUMER_GROUP=streamvault-pipeline
PIPELINE_METRICS_INTERVAL=15 seconds

# ── Observability (full profile only: docker compose --profile full up -d) ───
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
# generate with: openssl rand -hex 24
GF_SECURITY_ADMIN_PASSWORD=
KAFKA_UI_PORT=8090
