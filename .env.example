# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=streamvault
POSTGRES_PASSWORD=changeme
POSTGRES_DB=streamvault_core
POSTGRES_PIPELINE_DB=streamvault_pipeline

# ── Kafka (KRaft) ──────────────────────────────────────────────────────────
# Generate with: docker run --rm bitnami/kafka:3.7.1 kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=-T-Nd9zZRx-fSI2-fRXetw
KAFKA_NODE_ID=1

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# ── RustFS (S3-compatible object storage) ──────────────────────────────────
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=changeme
RUSTFS_PORT=9000
# Bucket name used by core and pipeline for media storage
STREAMVAULT_S3_BUCKET=streamvault-media
STREAMVAULT_S3_REGION=us-east-1

# ── Application ────────────────────────────────────────────────────────────
CORE_IMAGE=ghcr.io/streamvault/core:dev
PIPELINE_IMAGE=ghcr.io/streamvault/pipeline:dev

# ── Envoy ──────────────────────────────────────────────────────────────────
ENVOY_HTTP_PORT=8080
ENVOY_HTTPS_PORT=8443

# ── Observability (override only) ──────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
